PORT=3001

JWT_SECRET=uzun-rastgele-gizli-bir-metin-yaz

# Yönetim arayüzü (/admin/diyetisyen-onay): isteklerde X-Admin-Key başlığı bu değere eşit olmalı.

ADMIN_API_KEY=yazilacak-bir-uzun-rastgele-metin



# --- MSSQL Docker (docker-compose.yml ile aynı SA şifresi) ---

# Repo varsayılanı: OpenHealth_Dev_1 (sonunda ! yok). Ekip farklı şifreyle volume oluşturduysa Password ona göre olmalı.

MSSQL_SA_PASSWORD=OpenHealth_Dev_1

MSSQL_CONNECTION_STRING=Server=127.0.0.1,1433;Database=DiyetDB;User Id=sa;Password=OpenHealth_Dev_1;Encrypt=true;TrustServerCertificate=true



# Yerel Windows SQL Express:

# MSSQL_CONNECTION_STRING=Server=.\SQLEXPRESS;Database=DiyetDB;User Id=sa;Password=...;Encrypt=true;TrustServerCertificate=true
